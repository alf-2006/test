{
  "version": 2,
  "buildCommand": "cd artifacts/royal-letters && pnpm install && pnpm exec vite build --config vite.config.vercel.ts",
  "outputDirectory": "artifacts/royal-letters/dist/public",
  "installCommand": "pnpm install",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
